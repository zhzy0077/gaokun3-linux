# This device uses the Qualcomm SC8280XP platform.
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# Production device kernel: omit in-kernel KUnit test suites.
# CONFIG_KUNIT is not set

# Gaokun uses Qualcomm Adreno; omit GPU families absent from this board.
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_NOVA is not set
# CONFIG_DRM_XE is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_PANTHOR is not set
# CONFIG_DRM_POWERVR is not set
# CONFIG_DRM_V3D is not set
# CONFIG_DRM_VC4 is not set

# Boot contract: use the project's DT rather than the incomplete firmware ACPI tables.
CONFIG_ARCH_QCOM=y
# CONFIG_ACPI is not set
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_OF_OVERLAY=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_MODULES=y

# Early storage, USB and interrupt/clock dependencies retain the validated built-ins.
CONFIG_PCIE_QCOM=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=m
CONFIG_QCOM_BAM_DMA=y
CONFIG_QCOM_GPI_DMA=m
CONFIG_ARM_SMMU=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SC_GCC_8280XP=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SC8280XP=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=m
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_REFGEN=m
CONFIG_I2C_QCOM_GENI=m
CONFIG_SPI_QCOM_GENI=m
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_NVMEM_SPMI_SDAM=m
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_THERMAL=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=m
CONFIG_RTC_DRV_PM8XXX=y

# Huawei EC patches: battery, keyboard/RTC wake, USB-C and connector orientation.
CONFIG_EC_HUAWEI_GAOKUN=y
CONFIG_BATTERY_HUAWEI_GAOKUN=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_HUAWEI_GAOKUN=y
CONFIG_TYPEC_MUX_GPIO_SBU=m
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_POWER_RESET_QCOM_PON=y

# Bonded DSI/PLL, DSC, backlight and GPIO174 SPI touchscreen patches.
CONFIG_DRM=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_HIMAX_HX83121A=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_TOUCHSCREEN_HIMAX_HX83121A_SPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_HID_OF=m
CONFIG_SC_DISPCC_8280XP=m
CONFIG_SC_GPUCC_8280XP=m
CONFIG_QCOM_LLCC=m
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=128

# ADSP/CDSP/SLPI attachment and QSEECOM/SHM bridge patches (including EL2).
CONFIG_REMOTEPROC=y
CONFIG_QCOM_Q6V5_ADSP=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_SYSMON=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y
CONFIG_QCOM_QSEECOM=y
CONFIG_QCOM_QSEECOM_UEFISECAPP=y
CONFIG_QCOM_FASTRPC=m
CONFIG_KVM=y

# Audio reserved-memory and board codec support.
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_WCD938X_SDW=m
CONFIG_SND_SOC_WSA883X=m
CONFIG_SND_SOC_LPASS_WSA_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SC_LPASSCC_8280XP=m
CONFIG_PINCTRL_SC8280XP_LPASS_LPI=m
CONFIG_QCOM_APR=m

# Project camera/ISP patches and lens support.
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_VIDEO_HI846=m
CONFIG_VIDEO_OV13B10=m
CONFIG_VIDEO_DW9714=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_SC_CAMCC_8280XP=m
CONFIG_SM_VIDEOCC_8350=m

# WCN6855 firmware/address patch and QRTR consumers.
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m

# QSEE TPM validation contract: opt-in probe, no provisioning or PCR writes.
CONFIG_TCG_TPM=m
CONFIG_TCG_QCOM_TPM_QSEE=m
# CONFIG_TCG_TPM2_HMAC is not set
# CONFIG_HW_RANDOM_TPM is not set
# CONFIG_IMA is not set

