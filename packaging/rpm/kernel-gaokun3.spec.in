%global debug_package %{nil}
%global _debugsource_packages 0

Name:           @PKG_NAME@
Version:        @KREL_VERSION@
Release:        16%{?dist}
Summary:        Kernel image, DTB, config, and System.map for the gaokun3 kernel
License:        GPL-2.0-only
ExclusiveArch:  aarch64
Source0:        @SOURCE_NAME@
# Anaconda discovers installed kernel images through this capability.
Provides:       kernel = %{version}-%{release}
Requires(posttrans): dracut
Requires(posttrans): systemd
Requires(posttrans): gaokun3-boot-integration >= 2
Requires(preun): systemd

%description
Kernel image, boot DTB copy, config, and System.map for the gaokun3 kernel @KREL@.

%prep
%setup -q -c -T
tar -xzf %{SOURCE0}

%build

%install
mkdir -p %{buildroot}
cp -a boot %{buildroot}/
cp -a usr %{buildroot}/

%posttrans
# The platform helper derives first-install parameters from the target fstab,
# then passes one generated initrd to kernel-install. Anaconda installs the loader.
%{_libexecdir}/gaokun3/kernel-setup @KREL@ qcom/@DTB_FILE@

%preun
if [ "$1" -eq 0 ] && command -v kernel-install >/dev/null 2>&1; then
    kernel-install --esp-path=/boot/efi --entry-token=machine-id remove @KREL@ >/dev/null 2>&1 || :
fi

%files
/boot/vmlinuz-@KREL@
/boot/System.map-@KREL@
/boot/config-@KREL@
/boot/dtb-@KREL@/qcom/@DTB_FILE@
/usr/lib/dracut/dracut.conf.d/90-gaokun3-@KREL@.conf

%changelog
* Tue Oct 20 2026 Gaokun buildbot - @KREL_VERSION@-16
- Preserve Gaokun3 PHY common power across live Type-C reconfiguration
- Fix EC UCSI ACK encoding and QMP error-path resource ownership

* Mon Oct 19 2026 Gaokun buildbot - @KREL_VERSION@-15
- Honor plane CRTC masks in the DPU allocator to fix display-owner handoff

* Thu Oct 15 2026 Gaokun buildbot - @KREL_VERSION@-14
- Integrate SC8280XP hardware decoding and EL2 firmware boot support

* Wed Oct 14 2026 Gaokun buildbot - @KREL_VERSION@-13
- Wait for transiently unavailable SMP2P state before no-reset EL2 attachment
- Retain attach-error diagnostics and calibrate Gaokun3 speaker playback gain

* Sat Oct 10 2026 Gaokun buildbot - @KREL_VERSION@-12
- Pin Gaokun3 primary planes to their CRTCs for display-owner handoff
- Retain asynchronous UCSI initialization and disconnect recovery

* Sat Oct 10 2026 Gaokun buildbot - @KREL_VERSION@-11
- Recover asynchronous Gaokun UCSI initialization without replacing DRM bridges
- Replay all Type-C port states and process USB/DP events outside the EC IRQ thread

* Wed Oct 07 2026 Gaokun buildbot - @KREL_VERSION@-10
- Start from the pinned Fedora arm64 configuration and retain Gaokun patch requirements
- Add opt-in QSEE fTPM validation with HLOS sharing for firmware control memory
- Integrate Gaokun CPU/touchscreen support and early firmware collection
- Support Anaconda discovery and safe kernel-install updates

* Sat Mar 28 2026 cool <bilibili@att.net> - @KREL_VERSION@-1
- Build gaokun3 kernel boot RPM
