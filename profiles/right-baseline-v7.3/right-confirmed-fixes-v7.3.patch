+/* Windows CAMS_RES_QRD: reset -> rails -> 1ms -> reset release -> 10ms -> MCLK. */
+static int ov13b10_gaokun3_power_on(struct ov13b10 *ov13b)
+{
+	int ret;
+
+	gpiod_set_value_cansleep(ov13b->reset, 1);
+
+	/* L2B also supplies display VDDI, which idles at 1.8V. */
+	ret = regulator_set_voltage(ov13b->supplies[1].consumer,
+				    2800000, 2800000);
+	if (ret)
+		return ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ov13b10_supply_names),
+				    ov13b->supplies);
+	if (ret)
+		goto err_voltage;
+
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(ov13b->reset, 0);
+	usleep_range(10000, 11000);
+
+	ret = clk_prepare_enable(ov13b->img_clk);
+	if (ret)
+		goto err_supplies;
+
+	usleep_range(5000, 5500);
+	return 0;
+
+err_supplies:
+	gpiod_set_value_cansleep(ov13b->reset, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ov13b10_supply_names), ov13b->supplies);
+err_voltage:
+	ov13b10_gaokun3_release_avdd(ov13b);
+	return ret;
