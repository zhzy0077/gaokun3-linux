+/* Restore the shared AVDD/display rail's idle voltage range. */
+static void ov13b10_gaokun3_release_avdd(struct ov13b10 *ov13b)
+{
+	int ret;
+
+	ret = regulator_set_voltage(ov13b->supplies[1].consumer,
+				    1800000, 2800000);
+	if (ret)
+		dev_warn(ov13b->dev, "failed to release AVDD voltage vote: %d\n", ret);
