[Unit]
Description=Persistent Gaokun USB test-boot capture
ConditionKernelCommandLine=gaokun.usb_capture=1
After=local-fs.target systemd-journald.service
Before=display-manager.service

[Service]
Type=exec
ExecStart=/usr/local/libexec/gaokun-usb-capture --output /var/log/gaokun-usb/test-boot-%b --follow --seconds 3600
UMask=0077
TimeoutStopSec=60
RuntimeMaxSec=3700
KillMode=mixed

[Install]
WantedBy=multi-user.target
