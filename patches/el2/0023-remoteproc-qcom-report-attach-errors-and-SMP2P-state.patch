index f034bb6..a1e5676 100644
--- a/drivers/remoteproc/qcom_q6v5.h
+++ b/drivers/remoteproc/qcom_q6v5.h
@@ -30,30 +30,30 @@ struct qcom_q6v5 {
 	int stop_irq;
 
