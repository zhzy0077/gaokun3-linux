From baacbb01c901937d04ffd7d8ca4c11f3fbe4aa31 Mon Sep 17 00:00:00 2001
From: zhzy0077 <zhzy0077@users.noreply.github.com>
Date: Mon, 19 Oct 2026 22:50:28 +0800
Subject: [PATCH] phy: qcom: qmp-combo: preserve common power on Gaokun

Keep common clocks and regulator votes during forced Type-C reconfiguration
on Gaokun3, using the DP COM internal software reset instead of cycling the
external common resources under the live DWC3 controller. Initial power-up
and final shutdown retain their existing resource lifecycle.

With the same test kernel, the control boot failed to enumerate the USB2
hub and mouse receiver. Enabling this path allowed USB2 and USB3 hubs,
Logitech G304 and Keychron receivers to enumerate and remain connected
during a one-minute observation. Enable the board-scoped path by default;
retain gaokun_keep_common_power=0 for rollback and further comparisons.
---
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 7f18004..d3cbb05 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -4003,6 +4003,20 @@ static int qmp_combo_dp_calibrate(struct phy *phy)
 	return ret;
 }
 
+/* Keep common clocks/rails across live Type-C changes on Gaokun3.
+ * Enabled by default; the read-only parameter permits boot-time rollback.
+ */
+static bool gaokun_keep_common_power = true;
+module_param(gaokun_keep_common_power, bool, 0444);
+MODULE_PARM_DESC(gaokun_keep_common_power,
+	"Gaokun: preserve common power during live Type-C reconfiguration");
+
+static bool qmp_combo_keep_common_power(bool force)
+{
+	return force && gaokun_keep_common_power &&
+		of_machine_is_compatible("huawei,gaokun3");
+}
+
 static int qmp_combo_com_init(struct qmp_combo *qmp, bool force)
 {
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
@@ -4019,6 +4033,13 @@ static int qmp_combo_com_init(struct qmp_combo *qmp, bool force)
 	else
 		aon_toggle = qmp->pcs_aon;
 
+	if (qmp_combo_keep_common_power(force)) {
+		dev_dbg(qmp->dev, "live reconfigure: orientation=%u mode=%u users=%d usb=%d dp=%d\n",
+			 qmp->orientation, qmp->qmpphy_mode, qmp->init_count,
+			 qmp->usb_init_count, qmp->dp_init_count);
+		goto configure;
+	}
+
 	ret = regulator_bulk_enable(cfg->num_vregs, qmp->vregs);
 	if (ret) {
 		dev_err(qmp->dev, "failed to enable regulators, err=%d\n", ret);
@@ -4048,6 +4069,7 @@ static int qmp_combo_com_init(struct qmp_combo *qmp, bool force)
 		goto err_disable_clocks;
 	}
 
+configure:
 	qphy_setbits(com, QPHY_V3_DP_COM_POWER_DOWN_CTRL, SW_PWRDN);
 
 	/* override hardware control for reset of qmp phy */
@@ -4126,6 +4148,12 @@ static int qmp_combo_com_exit(struct qmp_combo *qmp, bool force)
 	if (!force && --qmp->init_count)
 		return 0;
 
+	if (qmp_combo_keep_common_power(force)) {
+		/* Preserve resources used by the still-live DWC3 controller. */
+		qphy_setbits(qmp->com, QPHY_V3_DP_COM_SW_RESET, SW_RESET);
+		return 0;
+	}
+
 	reset_control_bulk_assert(cfg->num_resets, qmp->resets);
 
 	clk_disable_unprepare(qmp->pipe_clk);
-- 
2.56.0
